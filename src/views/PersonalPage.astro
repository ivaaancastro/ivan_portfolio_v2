---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { ArrowUpRight } from "lucide-react";
import StravaStats from "../components/StravaStats.astro";
import { getStravaStats } from "../utils/strava";
import { getLang, useTranslations } from "../i18n/utils";
import { Image } from "astro:assets";
import runningImg from "../assets/img/ivan-running.jpeg";
import bikeImg from "../assets/img/ivan-bike.jpeg";
import familyImg from "../assets/img/ivan-family.jpg";
import friendsImg from "../assets/img/ivan-running-friends.jpeg";

// Sport photos fill half of a 1100px row; social photos a third.
const halfSizes = "(min-width: 768px) 530px, 100vw";
const thirdSizes = "(min-width: 768px) 350px, 100vw";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const stats = await getStravaStats();
const runDistance = stats?.ytd_run_totals.distance ?? 0;
const rideDistance = stats?.ytd_ride_totals.distance ?? 0;

const sportPhotos = [
  {
    src: runningImg,
    widths: [530, 800, 1060],
    alt: t("life.runningAlt"),
    title: t("life.runningTitle"),
    text: t("life.runningText"),
    position: "center",
  },
  {
    src: bikeImg,
    widths: [530, 800, 1024],
    alt: t("life.cyclingAlt"),
    title: t("life.cyclingTitle"),
    text: t("life.cyclingText"),
    position: "center 60%",
  },
];

const socialPhotos = [
  { src: familyImg, alt: t("life.family"), position: "center" },
  { src: friendsImg, alt: t("life.friends"), position: "center 30%" },
];

// Emphasis inside the HTML texts uses the ink colour instead of the soft one.
const richText = "[&_strong]:font-semibold [&_strong]:text-ink";
const photoFrame = "overflow-hidden border-frame bg-paper-raised";
const photoImg =
  "size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transition-none";
---

<Layout title={t("life.title")} description={t("life.description")}>
  <Navbar />

  <main class="pt-16 font-display text-ink">
    <!-- No big title: the page goes straight to its content. -->
    <h1 class="sr-only">{t("life.kicker")}</h1>

    <!-- Sport -->
    <section class="border-b-[1.5px] border-ink bg-paper py-section">
      <div class="mx-auto grid max-w-[1100px] gap-block px-6">
        <h2 class="text-h2 font-extrabold stretch-heading">{t("life.sportTitle")}</h2>

        <div class="grid items-start gap-block md:grid-cols-2">
          <div class="grid gap-6">
            <p
              class:list={["max-w-[60ch] text-ink-soft", richText]}
              set:html={t("life.sportText")}
            />
            <a
              href="https://www.strava.com/athletes/102757003"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex h-12 w-fit items-center gap-2 rounded-control border-frame bg-paper-raised px-5 font-semibold hover:bg-ink hover:text-paper"
            >
              <span class="size-2 rounded-full bg-strava" aria-hidden="true"></span>
              {t("life.followStrava")}
              <ArrowUpRight
                className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none"
                aria-hidden="true"
              />
            </a>
          </div>

          <StravaStats runDistance={runDistance} rideDistance={rideDistance} />
        </div>

        <div class="grid gap-grid md:grid-cols-2">
          {sportPhotos.map(({ src, widths, alt, title, text, position }, index) => (
            <figure data-develop class="group grid" style={`--i: ${index}`}>
              <div class:list={[photoFrame, "aspect-[4/3]"]}>
                <Image
                  src={src}
                  widths={widths}
                  sizes={halfSizes}
                  format="webp"
                  alt={alt}
                  style={`object-position: ${position}`}
                  class={photoImg}
                />
              </div>
              <figcaption class="grid border-x-[1.5px] border-b-[1.5px] border-ink bg-paper-raised px-4 py-3">
                <span class="font-bold">{title}</span>
                <span class="text-small text-ink-soft">{text}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Family and friends -->
    <section class="bg-paper py-section">
      <div class="mx-auto grid max-w-[1100px] gap-block px-6">
        <h2 class="text-h2 font-extrabold stretch-heading">{t("life.socialTitle")}</h2>

        <div class="grid gap-grid md:grid-cols-3">
          <div class="grid content-center gap-3 border-frame bg-paper-raised p-5 text-lead md:p-6">
            <p>{t("life.socialText1")}</p>
            <p class="text-ink-soft">{t("life.socialText2")}</p>
          </div>

          {socialPhotos.map(({ src, alt, position }, index) => (
            <figure data-develop class="group grid" style={`--i: ${index + 1}`}>
              <div class:list={[photoFrame, "aspect-[4/5]"]}>
                <Image
                  src={src}
                  widths={[400, 700, 1000]}
                  sizes={thirdSizes}
                  format="webp"
                  alt={alt}
                  style={`object-position: ${position}`}
                  class={photoImg}
                />
              </div>
              <figcaption class="border-x-[1.5px] border-b-[1.5px] border-ink bg-paper-raised px-4 py-3 font-bold">
                {alt}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import "../scripts/develop";
</script>

---
import { getImage, Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import { ArrowLeft, ArrowRight, ArrowUpRight } from "lucide-react";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Github } from "../components/icons/brand";
import { getProjects, projectSlug } from "../utils/content";
import { getLang, pathFor, projectPath, useTranslations } from "../i18n/utils";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const project = entry.data;
const slug = projectSlug(entry);
const { Content } = await render(entry);

// Previous / next project, in the same order as the home grid (wraps around).
const all = await getProjects(lang);
const index = all.findIndex((other) => projectSlug(other) === slug);
const prev = all[(index - 1 + all.length) % all.length];
const next = all[(index + 1) % all.length];
const neighbours = [
  { entry: prev, label: t("projects.prev"), dir: "prev" },
  { entry: next, label: t("projects.next"), dir: "next" },
] as const;

// Share image: the cover cropped to 1200x630.
const ogImage = await getImage({
  src: project.cover,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});

const title = t("projects.metaTitle").replace("{title}", project.title);
const sheet = t("projects.sheet")
  .replace("{n}", String(index + 1))
  .replace("{total}", String(all.length));

// Case-study text from the MDX body, styled for the paper theme.
const prose =
  "grid max-w-[68ch] gap-4 text-ink-soft [&_code]:text-small [&_code]:text-cobalt [&_h2]:mt-6 [&_h2]:text-h3 [&_h2]:font-bold [&_h2]:text-ink [&_h2]:stretch-subheading [&_li]:pl-1 [&_li+li]:mt-2 [&_strong]:font-semibold [&_strong]:text-ink [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:marker:text-cobalt";
---

<Layout title={title} description={project.shortDesc} image={ogImage.src} imageAlt={project.title}>
  <Navbar />

  <main class="pt-16 font-display text-ink">
    <article>
      <!-- Sheet header -->
      <header class="border-b-[1.5px] border-ink bg-drafting-grid">
        <div class="mx-auto grid max-w-[1100px] gap-block px-6 pt-section pb-block">
          <div class="grid gap-head">
            <a
              href={pathFor(lang, "#projects")}
              class="group inline-flex w-fit items-center gap-2 text-small font-semibold text-ink-soft hover:text-cobalt"
            >
              <ArrowLeft
                className="size-4 transition-transform group-hover:-translate-x-0.5 motion-reduce:transition-none"
                aria-hidden="true"
              />
              {t("projects.back")}
            </a>
            <p class="mt-6 flex flex-wrap items-center gap-3 text-caption font-semibold">
              <span class="text-redline">{sheet}</span>
              {project.featured && (
                <span class="border border-cobalt px-2 py-0.5 text-cobalt">
                  {t("projects.featured")}
                </span>
              )}
            </p>
            <h1 class="text-h1 font-extrabold stretch-display">{project.title}</h1>
            <p class="max-w-[52ch] text-lead text-ink-soft">{project.shortDesc}</p>
          </div>

          <Image
            src={project.cover}
            widths={[400, 700, 1000, 1400, 1800]}
            sizes="(min-width: 1148px) 1052px, 100vw"
            format="webp"
            alt={project.title}
            loading="eager"
            fetchpriority="high"
            style={`view-transition-name: project-${slug}; view-transition-class: project-cover`}
            class="aspect-video w-full border-frame bg-paper-raised object-cover"
          />
        </div>
      </header>

      <!-- Case study + title block -->
      <div class="mx-auto grid max-w-[1100px] gap-block px-6 py-section md:grid-cols-[minmax(0,1fr)_280px]">
        <div class={prose}>
          <Content />
        </div>

        <aside class="grid self-start border-frame bg-paper-raised text-small md:sticky md:top-24">
          <section class="grid gap-3 border-b border-ink p-4">
            <h2 class="text-caption text-ink-soft">{t("projects.stack")}</h2>
            <ul class="flex flex-wrap gap-2 text-caption">
              {project.tags.map((tag) => (
                <li class="border border-cobalt px-2 py-0.5 text-cobalt">{tag}</li>
              ))}
            </ul>
          </section>
          <section class="grid gap-3 p-4">
            <h2 class="text-caption text-ink-soft">{t("projects.links")}</h2>
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex h-11 items-center justify-between gap-2 rounded-control bg-ink px-4 font-semibold text-paper hover:bg-cobalt"
            >
              <span class="inline-flex items-center gap-2">
                <Github size={16} aria-hidden="true" />
                {t("projects.viewCode")}
              </span>
              <ArrowUpRight
                className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none"
                aria-hidden="true"
              />
            </a>
          </section>
        </aside>
      </div>

      <!-- Previous / next sheet -->
      {all.length > 1 && (
        <nav aria-label={t("projects.more")} class="border-t-[1.5px] border-ink bg-paper">
          <ul class="mx-auto grid max-w-[1100px] gap-grid px-6 py-block sm:grid-cols-2">
            {neighbours.map(({ entry: other, label, dir }) => (
              <li>
                <a
                  href={projectPath(lang, projectSlug(other))}
                  class:list={[
                    "group flex h-full flex-col gap-1 border-frame bg-paper-raised p-5 hover:border-cobalt md:p-6",
                    { "sm:items-end sm:text-right": dir === "next" },
                  ]}
                >
                  <span class="inline-flex items-center gap-1.5 text-caption font-semibold text-ink-soft">
                    {dir === "prev" && (
                      <ArrowLeft
                        className="size-3.5 transition-transform group-hover:-translate-x-0.5 motion-reduce:transition-none"
                        aria-hidden="true"
                      />
                    )}
                    {label}
                    {dir === "next" && (
                      <ArrowRight
                        className="size-3.5 transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none"
                        aria-hidden="true"
                      />
                    )}
                  </span>
                  <span class="text-h3 font-bold stretch-subheading group-hover:text-cobalt">
                    {other.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </article>
  </main>

  <Footer />
</Layout>

---
// Layout.astro
import "../styles/global.css";
import { Font } from "astro:assets";
import BottomNav from "../components/BottomNav.astro";

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative URL of the share image (1200x630). */
  image?: string;
  /** Hide the page from search engines (e.g. 404). */
  noindex?: boolean;
}

const {
  title,
  description = "Portfolio de Iván Castro Roel, ingeniero informático: experiencia, proyectos de software (Java, Spring Boot, React, IA) y contacto.",
  image = "/og.png",
  noindex = false,
} = Astro.props;

const canonicalPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = new URL(canonicalPath, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <!-- Lets CSS hide [data-reveal] elements only when JS can reveal them again. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e0f12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Iván Castro Roel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Iván Castro, ingeniero informático" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <Font
      cssVariable="--font-inter"
      preload={[
        { weight: 400, subset: "latin" },
        { weight: 700, subset: "latin" },
      ]}
    />

    <title>{title}</title>
  </head>
  <body class="bg-bg text-gray-100 font-sans antialiased selection:bg-primary selection:text-black">
    <div class="fixed top-0 left-0 z-[-10] h-full w-full bg-bg">
      <div class="absolute top-0 z-[-2] h-screen w-screen bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(108,240,194,0.15),rgba(255,255,255,0))]"></div>
    </div>

    <slot />

    <BottomNav />

    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>

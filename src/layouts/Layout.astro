---
// Layout.astro
import "../styles/global.css";
import { Font } from "astro:assets";
import { defaultLang, isPublished, ogLocales, publishedLangs, type Lang } from "../i18n/config";
import { getLang, switchLangPath, useTranslations } from "../i18n/utils";

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative URL of the share image (1200x630). */
  image?: string;
  /** Alt text of the share image; defaults to the photo of Iván. */
  imageAlt?: string;
  /** Hide the page from search engines (e.g. 404). */
  noindex?: boolean;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const {
  title,
  description = t("meta.description"),
  image = "/og.png",
  imageAlt = t("meta.ogImageAlt"),
  noindex: noindexProp = false,
} = Astro.props;

// Pages in a language that is not published yet stay out of search engines.
const noindex = noindexProp || !isPublished(lang);

const canonicalPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = new URL(canonicalPath, Astro.site);
const imageUrl = new URL(image, Astro.site);

// hreflang alternates: only between published languages, plus x-default (Spanish).
const alternates: { hreflang: string; href: URL }[] =
  noindex || publishedLangs.length < 2
    ? []
    : [
        ...publishedLangs.map((alt: Lang) => ({
          hreflang: alt,
          href: new URL(switchLangPath(canonicalPath, alt), Astro.site),
        })),
        {
          hreflang: "x-default",
          href: new URL(switchLangPath(canonicalPath, defaultLang), Astro.site),
        },
      ];
const otherOgLocales = publishedLangs.filter((alt) => alt !== lang).map((alt) => ogLocales[alt]);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <!-- Lets CSS hide [data-reveal] elements only when JS can reveal them again. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      // Theme picked by the visitor (light/dark); without one, the OS setting applies.
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked (private mode): fall back to the OS setting.
      }
    </script>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2f4f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1a2c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {otherOgLocales.map((locale) => (
      <meta property="og:locale:alternate" content={locale} />
    ))}
    <meta property="og:site_name" content="Iván Castro Roel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <Font
      cssVariable="--font-inter"
      preload={[
        { weight: 400, subset: "latin" },
        { weight: 700, subset: "latin" },
      ]}
    />

    <Font cssVariable="--font-archivo" preload={[{ weight: "400 800", subset: "latin" }]} />

    <title>{title}</title>
  </head>
  <body class="bg-paper font-display text-ink antialiased selection:bg-cobalt selection:text-paper">
    <slot />

    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>

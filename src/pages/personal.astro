---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Trophy, Users, Bike, ExternalLink, Activity, Heart } from 'lucide-react'; 
import StravaStats from '../components/StravaStats';
import { getStravaStats } from '../utils/strava';

const stats = await getStravaStats();
const runDistance = stats?.ytd_run_totals?.distance || 0;
const rideDistance = stats?.ytd_ride_totals?.distance || 0;
---

<Layout title="Iván Castro | Lifestyle">
  <Navbar />
  
  <main class="pt-32 pb-28 px-6 overflow-hidden">
    <div class="max-w-[1100px] mx-auto space-y-24 md:space-y-32">
      
      {/* 1. HERO */}
      <section class="text-center relative">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-pink-500/10 blur-[120px] rounded-full pointer-events-none -z-10"></div>
        <span class="text-pink-400 font-bold tracking-wide uppercase text-sm mb-4 block">Lifestyle</span>
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
          Más allá del <span class="text-primary drop-shadow-[0_0_15px_rgba(108,240,194,0.3)]">Código</span>.
        </h1>
        <p class="text-gray-400 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          Ingeniería es disciplina. El deporte también. Así encuentro mi equilibrio entre la pantalla y el mundo real.
        </p>
      </section>

      {/* 2. SECCIÓN 01 — DEPORTE & DISCIPLINA */}
      <section class="relative">
        {/* Cabecera numerada */}
        <div class="flex items-center gap-5 mb-12">
          <span class="font-mono text-5xl md:text-6xl font-bold text-white/10 leading-none select-none">01</span>
          <span class="p-2.5 bg-orange-500/10 text-orange-500 rounded-xl border border-orange-500/20">
            <Activity size={20} />
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-white">Deporte & Disciplina</h2>
        </div>
        
        {/* Texto + Stats */}
        <div class="grid md:grid-cols-2 gap-10 md:gap-12 items-center mb-12">
          <div class="max-w-2xl">
            <p class="text-gray-300 text-base md:text-lg leading-relaxed mb-6">
              El equilibrio perfecto entre el esfuerzo continuo y la libertad de explorar. Preparar <strong class="text-white">Medias Maratones</strong>, correr todo tipo de carreras y acumular kilómetros en bici me han enseñado que los grandes objetivos se logran con constancia diaria.
            </p>
            
            <a 
              href="https://www.strava.com/athletes/102757003" 
              target="_blank"
              rel="noopener noreferrer" 
              class="group w-fit inline-flex items-center justify-center gap-3 bg-[#FC4C02]/10 text-[#FC4C02] border border-[#FC4C02]/30 px-6 py-3.5 md:px-8 md:py-4 rounded-full font-bold text-sm md:text-base hover:bg-[#FC4C02] hover:text-white transition-all shadow-[0_0_20px_rgba(252,76,2,0.1)] hover:shadow-[0_0_30px_rgba(252,76,2,0.4)] hover:-translate-y-1"
            >
              <Bike size={20} class="group-hover:animate-bounce" />
              Sígueme en Strava <ExternalLink size={18} class="group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
            </a>
          </div>
          
          <StravaStats client:load runDistance={runDistance} rideDistance={rideDistance} />
        </div>

        {/* Fotos alineadas, sin escalones */}
        <div class="grid md:grid-cols-2 gap-6 md:gap-8">
          {/* Running */}
          <div class="relative group rounded-3xl overflow-hidden h-[300px] md:h-[400px] border border-white/10 shadow-xl bg-card">
              <img 
                src="/img/ivan-running.jpeg" 
                alt="Corriendo" 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-70 group-hover:opacity-60" 
                onerror="this.style.display='none'" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"></div>
              
              <div class="relative z-10 w-full h-full p-8 flex flex-col justify-end">
                <div class="w-12 h-12 bg-orange-500/20 rounded-2xl flex items-center justify-center text-orange-400 border border-orange-500/30 backdrop-blur-md mb-4 shadow-[0_0_15px_rgba(249,115,22,0.2)]">
                   <Trophy size={24} />
                </div>
                <h3 class="text-2xl font-bold text-white mb-1">Running</h3>
                <p class="text-gray-300 text-sm md:text-base">Resiliencia kilómetro a kilómetro.</p>
              </div>
          </div>

          {/* Ciclismo */}
          <div class="relative group rounded-3xl overflow-hidden h-[300px] md:h-[400px] border border-white/10 shadow-xl bg-card">
              <img 
                src="/img/ivan-bike.jpeg" 
                alt="Ciclismo" 
                style="object-position: center 60%;" 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-70 group-hover:opacity-60" 
                onerror="this.style.display='none'" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"></div>
              
               <div class="relative z-10 w-full h-full p-8 flex flex-col justify-end">
                <div class="w-12 h-12 bg-[#FC4C02]/20 rounded-2xl flex items-center justify-center text-[#FC4C02] border border-[#FC4C02]/30 backdrop-blur-md mb-4 shadow-[0_0_15px_rgba(252,76,2,0.2)]">
                   <Bike size={24} />
                </div>
                <h3 class="text-2xl font-bold text-white mb-1">Ciclismo</h3>
                <p class="text-gray-300 text-sm md:text-base">Libertad, velocidad y desconexión.</p>
              </div>
          </div>
        </div>
      </section>

      {/* 3. SECCIÓN 02 — SOCIAL & FAMILIA */}
      <section class="relative">
        {/* Cabecera numerada */}
        <div class="flex items-center gap-5 mb-12">
          <span class="font-mono text-5xl md:text-6xl font-bold text-white/10 leading-none select-none">02</span>
          <span class="p-2.5 bg-pink-500/10 text-pink-400 rounded-xl border border-pink-500/20">
            <Users size={20} />
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-white">Social & Familia</h2>
        </div>

        {/* Texto + Fotos en una sola fila, sin escalones */}
        <div class="grid md:grid-cols-3 gap-6 md:gap-8">
          {/* Social Battery */}
          <div class="bg-gradient-to-br from-card to-gray-900 border border-white/10 rounded-3xl p-8 flex flex-col justify-center relative overflow-hidden group shadow-lg">
            <div class="relative z-10 h-full flex flex-col justify-center">
              <h3 class="text-2xl font-bold text-white mb-5 group-hover:text-pink-400 transition-colors text-balance">Mi "Social Battery"</h3>
              <p class="text-gray-300 text-base leading-relaxed mb-4 text-balance">
                El deporte me da fuerza, pero mi entorno me da estabilidad. Tengo la inmensa suerte de contar con una familia increíble que me aporta seguridad y valores inquebrantables.
              </p>
              <p class="text-gray-400 leading-relaxed text-sm text-balance">
                A eso se suma un grupo de amigos muy afín a mí, con los que comparto risas, viajes, experiencias y por supuesto, <span class="text-white">¡kilómetros!</span>
              </p>
            </div>
            <div class="absolute inset-0 bg-pink-500/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none mix-blend-overlay"></div>
          </div>

          {/* Familia */}
          <div class="relative rounded-3xl overflow-hidden border border-white/10 group shadow-lg h-[380px]">
            <img 
              src="/img/ivan-family.jpg" 
              alt="Familia" 
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              onerror="this.style.display='none'" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-gray-900/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
            <div class="absolute bottom-6 left-6 flex items-center gap-3">
              <span class="w-9 h-9 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/20">
                  <Heart size={16} class="fill-current" />
              </span>
              <span class="font-bold text-white text-lg tracking-wide">Familia</span>
            </div>
          </div>

          {/* Amigos */}
          <div class="relative rounded-3xl overflow-hidden border border-white/10 group shadow-lg h-[380px]">
            <img 
              src="/img/ivan-running-friends.jpeg" 
              alt="Amigos" 
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              style="object-position: center 30%;"
              onerror="this.style.display='none'" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-gray-900/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
            <div class="absolute bottom-6 left-6 flex items-center gap-3">
              <span class="w-9 h-9 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/20">
                  <Users size={16} />
              </span>
              <span class="font-bold text-white text-lg tracking-wide">Amigos</span>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>
  
  <Footer />
</Layout>

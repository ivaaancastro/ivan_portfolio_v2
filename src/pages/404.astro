---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { ArrowLeft } from "@lucide/astro";
import type { Lang } from "../i18n/config";
import { pathFor, useTranslations } from "../i18n/utils";

/*
 * A static host serves this single 404.html for every unknown URL, so the page carries
 * both languages: Spanish by default, English when the missing URL is under /en
 * (switched by the inline script below; without JS it stays in Spanish).
 */
const langs: Lang[] = ["es", "en"];
const texts = langs.map((lang) => {
  const t = useTranslations(lang);
  return {
    lang,
    title: t("notFound.title"),
    metaTitle: t("notFound.metaTitle"),
    text: t("notFound.text"),
    home: t("notFound.home"),
    lifestyle: t("notFound.lifestyle"),
  };
});
const en = texts[1];
const es = useTranslations("es");
---

<Layout title={es("notFound.metaTitle")} description={es("notFound.metaDescription")} noindex>
  <script is:inline define:vars={{ enTitle: en.metaTitle }}>
    if (/^\/en(\/|$)/.test(location.pathname)) {
      document.documentElement.lang = "en";
      document.title = enTitle;
    }
  </script>

  <Navbar />

  <main class="border-b-[1.5px] border-ink bg-drafting-grid pt-16 font-display text-ink">
    <section class="mx-auto grid min-h-[70vh] max-w-[1100px] content-center gap-block px-6 py-section">
      <!-- The code as a dimensioned figure: the only motion is the dimension line drawing in. -->
      <div class="grid w-fit gap-3" aria-hidden="true">
        <p class="text-title leading-none font-extrabold text-cobalt stretch-display">404</p>
        <p class="relative h-3">
          <span class="absolute inset-x-0 top-1/2 h-[1.5px] origin-left animate-draw bg-redline"></span>
          <span class="absolute top-0 left-0 h-3 w-[1.5px] bg-redline"></span>
          <span class="absolute top-0 right-0 h-3 w-[1.5px] bg-redline"></span>
        </p>
      </div>

      {texts.map((item) => (
        <div data-lang={item.lang} class="grid gap-head">
          <h1 class="text-h2 font-extrabold stretch-heading">{item.title}</h1>
          <p class="max-w-[46ch] text-lead text-ink">{item.text}</p>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={pathFor(item.lang)}
              class="group inline-flex h-12 items-center gap-2 rounded-control bg-ink px-5 font-semibold text-paper hover:bg-cobalt"
            >
              <ArrowLeft
                class="size-4 transition-transform group-hover:-translate-x-0.5 motion-reduce:transition-none"
                aria-hidden="true"
              />
              {item.home}
            </a>
            <a
              href={pathFor(item.lang, "personal")}
              class="inline-flex h-12 items-center rounded-control border-frame bg-paper px-5 font-semibold hover:bg-ink hover:text-paper"
            >
              {item.lifestyle}
            </a>
          </div>
        </div>
      ))}
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  html:not([lang="en"]) [data-lang="en"],
  html[lang="en"] [data-lang="es"] {
    display: none;
  }
</style>

---
import { getLang, useTranslations } from "../i18n/utils";

interface Props {
  /** Year-to-date distances in metres (0 when Strava is unavailable). */
  runDistance: number;
  rideDistance: number;
}

const { runDistance, rideDistance } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const numberLocale = lang === "en" ? "en-US" : "es-ES";

const runKms = Math.round(runDistance / 1000);
const rideKms = Math.round(rideDistance / 1000);
const totalKms = runKms + rideKms;
const currentYear = new Date().getFullYear();

const fmt = (n: number) => (isNaN(n) || n === 0 ? "..." : n.toLocaleString(numberLocale));
// Bar length: share of the year's total (half each when there is no data).
const share = (kms: number) => (kms && totalKms ? kms / totalKms : 0.5);

const sports = [
  { label: t("strava.running"), kms: runKms, bar: "bg-cobalt" },
  { label: t("strava.cycling"), kms: rideKms, bar: "bg-redline" },
];
---

<!-- Year-to-date kilometres, drawn as a title block. -->
<div data-strava class="strava grid border-frame bg-paper-raised">
  <div class="flex items-center justify-between border-b border-ink px-4 py-2 text-caption">
    <span class="font-semibold">
      {t("strava.summary")} {currentYear}
    </span>
    <span class="text-ink-soft">Strava</span>
  </div>

  <div class="grid gap-1 border-b border-ink p-4">
    <span class="text-caption text-ink-soft">
      {t("strava.total")} · {t("strava.runRide")}
    </span>
    <p class="flex items-baseline gap-2">
      <span
        class="text-h2 leading-none font-extrabold tabular-nums stretch-heading"
        data-count={totalKms || undefined}
        data-locale={numberLocale}
      >
        {fmt(totalKms)}
      </span>
      <span class="text-lead text-ink-soft">km</span>
    </p>
  </div>

  <dl class="grid sm:grid-cols-2">
    {sports.map(({ label, kms, bar }, index) => (
      <div
        class:list={[
          "grid gap-2 p-4",
          index === 0 && "border-b border-ink sm:border-r sm:border-b-0",
        ]}
      >
        <dt class="text-caption text-ink-soft">{label}</dt>
        <dd class="text-h3 font-bold tabular-nums">
          <span data-count={kms || undefined} data-locale={numberLocale}>
            {fmt(kms)}
          </span>
          <span class="ml-1 text-small font-normal text-ink-soft">km</span>
        </dd>
        <dd class="h-1.5 bg-grid" aria-hidden="true">
          <div
            class:list={["strava-bar h-full origin-left", bar]}
            style={`--share: ${share(kms)}`}
          ></div>
        </dd>
      </div>
    ))}
  </dl>
</div>

<script>
  import "../scripts/strava-count";
</script>

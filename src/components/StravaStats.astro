---
import { Trophy, Bike, Activity } from "lucide-react";
import { getLang, useTranslations } from "../i18n/utils";

interface Props {
  /** Year-to-date distances in metres (0 when Strava is unavailable). */
  runDistance: number;
  rideDistance: number;
}

const { runDistance, rideDistance } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const numberLocale = lang === "en" ? "en-US" : "es-ES";

const runKms = Math.round(runDistance / 1000);
const rideKms = Math.round(rideDistance / 1000);
const totalKms = runKms + rideKms;
const currentYear = new Date().getFullYear();

const fmt = (n: number) => (isNaN(n) || n === 0 ? "..." : n.toLocaleString(numberLocale));
const share = (kms: number) => (kms && totalKms ? `${(kms / totalKms) * 100}%` : "50%");
---

<div class="group relative w-full overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-card to-gray-900 p-8 shadow-2xl md:p-10">
  <!-- Brillos de fondo -->
  <div class="pointer-events-none absolute top-0 right-0 -z-10 h-64 w-64 rounded-full bg-orange-500/10 blur-[100px] transition-colors duration-700 group-hover:bg-orange-500/20"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 -z-10 h-64 w-64 rounded-full bg-strava/10 blur-[100px] transition-colors duration-700 group-hover:bg-strava/20"></div>

  <!-- Cabecera -->
  <div class="relative z-10 mb-8 flex items-center justify-between">
    <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 shadow-sm">
      <Activity size={16} className="text-strava" aria-hidden="true" />
      <span class="text-xs font-semibold tracking-[0.2em] text-gray-300 uppercase">
        {t("strava.summary")} {currentYear}
      </span>
    </div>
    <span class="text-[10px] tracking-widest text-gray-500 uppercase md:text-xs">Strava</span>
  </div>

  <!-- Banda de 3 métricas -->
  <div class="relative z-10 grid grid-cols-[1.3fr_1fr_1fr] gap-3 md:grid-cols-3 md:gap-6 md:divide-x md:divide-white/5">
    <!-- Distancia total -->
    <div data-reveal class="pr-0 md:pr-6">
      <p class="mb-3 text-[9px] tracking-widest text-gray-400 uppercase md:text-xs">
        {t("strava.total")}
      </p>
      <div class="flex items-baseline gap-1">
        <span class="text-2xl font-bold tracking-tight text-white sm:text-3xl md:text-5xl">
          {fmt(totalKms)}
        </span>
        <span class="text-base text-gray-500 md:text-xl">km</span>
      </div>
      <p class="mt-3 hidden text-[10px] text-gray-500 md:block md:text-xs">{t("strava.runRide")}</p>
    </div>

    <!-- Running -->
    <div data-reveal style="--reveal-delay: 150ms" class="px-0 md:px-6">
      <div class="mb-3 flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg border border-orange-500/30 bg-orange-500/20 text-orange-400 md:h-8 md:w-8">
          <Trophy size={14} className="md:hidden" aria-hidden="true" />
          <Trophy size={16} className="hidden md:block" aria-hidden="true" />
        </span>
        <p class="text-[9px] tracking-widest text-gray-400 uppercase md:text-xs">
          {t("strava.running")}
        </p>
      </div>
      <div class="mb-3 flex items-baseline gap-1">
        <span class="text-xl font-bold tracking-tight text-white md:text-3xl">{fmt(runKms)}</span>
        <span class="text-xs text-gray-500 md:text-base">km</span>
      </div>
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-gray-800">
        <div
          data-reveal="bar"
          style={`width: ${share(runKms)}; --reveal-delay: 200ms`}
          class="h-full rounded-full bg-gradient-to-r from-orange-600 to-orange-400"
        ></div>
      </div>
    </div>

    <!-- Ciclismo -->
    <div data-reveal style="--reveal-delay: 300ms" class="pl-0 md:pl-6">
      <div class="mb-3 flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg border border-strava/30 bg-strava/20 text-strava md:h-8 md:w-8">
          <Bike size={14} className="md:hidden" aria-hidden="true" />
          <Bike size={16} className="hidden md:block" aria-hidden="true" />
        </span>
        <p class="text-[9px] tracking-widest text-gray-400 uppercase md:text-xs">
          {t("strava.cycling")}
        </p>
      </div>
      <div class="mb-3 flex items-baseline gap-1">
        <span class="text-xl font-bold tracking-tight text-white md:text-3xl">{fmt(rideKms)}</span>
        <span class="text-xs text-gray-500 md:text-base">km</span>
      </div>
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-gray-800">
        <div
          data-reveal="bar"
          style={`width: ${share(rideKms)}; --reveal-delay: 400ms`}
          class="h-full rounded-full bg-gradient-to-r from-strava to-orange-500"
        ></div>
      </div>
    </div>
  </div>
</div>

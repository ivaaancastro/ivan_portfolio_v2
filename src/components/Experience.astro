---
import { Briefcase, Calendar } from "lucide-react";
import { getExperience, localize } from "../utils/content";

const lang = "es";
const experience = (await getExperience()).map(({ data }) => ({
  company: data.company,
  role: localize(data.role, lang),
  period: localize(data.period, lang),
  desc: localize(data.desc, lang),
  tags: data.tags,
}));
---

<section id="experience" class="relative py-24">
  <div class="mx-auto max-w-[1100px] px-6">
    <h2 data-reveal class="mb-16 flex items-center gap-3 text-3xl font-bold text-white md:text-4xl">
      <Briefcase className="h-8 w-8 text-primary" aria-hidden="true" />
      Experiencia Laboral
    </h2>

    <div class="relative ml-3 space-y-12 border-l-2 border-white/10 md:ml-6">
      {experience.map((item, index) => (
        <div
          data-reveal="left"
          style={`--reveal-delay: ${index * 200}ms`}
          class="relative pl-8 md:pl-12"
        >
          <!-- Punto de la línea de tiempo -->
          <span class="absolute top-2 -left-[9px] h-4 w-4 rounded-full bg-primary shadow-[0_0_10px_rgba(108,240,194,0.5)]" />

          <div class="mb-2 flex flex-col sm:flex-row sm:items-center sm:justify-between">
            <h3 class="text-xl font-bold text-white">{item.role}</h3>
            <span class="mt-1 flex items-center gap-1 text-sm font-medium text-primary sm:mt-0">
              <Calendar className="h-4 w-4" aria-hidden="true" /> {item.period}
            </span>
          </div>

          <h4 class="mb-4 text-lg font-medium text-gray-400">{item.company}</h4>
          <p class="mb-4 max-w-2xl leading-relaxed text-gray-300">{item.desc}</p>

          <div class="flex flex-wrap gap-2">
            {item.tags.map((tag) => (
              <span class="rounded-full border border-white/5 bg-white/5 px-3 py-1 text-xs text-muted">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

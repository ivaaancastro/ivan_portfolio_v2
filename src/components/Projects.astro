---
import { Image } from "astro:assets";
import { getProjects, projectSlug } from "../utils/content";
import { getLang, projectPath, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// Content lives in src/content/projects/<lang>/*.mdx; the MDX body is the case study page.
const entries = await getProjects(lang);
const projects = entries.map((entry, index) => ({
  ...entry.data,
  slug: projectSlug(entry),
  href: projectPath(lang, projectSlug(entry)),
  sheet: t("projects.sheet")
    .replace("{n}", String(index + 1))
    .replace("{total}", String(entries.length)),
}));

const [featured, ...rest] = projects;
const coverStyle = (slug: string) =>
  `view-transition-name: project-${slug}; view-transition-class: project-cover`;

// Each sheet is one link: the title link covers the whole sheet (after:inset-0).
const sheetClass =
  "group relative grid border-frame bg-paper-raised hover:border-cobalt has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-4 has-[:focus-visible]:outline-cobalt";
const titleLinkClass = "outline-none after:absolute after:inset-0 after:content-['']";
---

<section
  id="projects"
  class="scroll-mt-16 border-b-[1.5px] border-ink bg-paper py-section font-display text-ink"
>
  <div class="mx-auto grid max-w-[1100px] gap-block px-6">
    <header class="grid gap-head">
      <h2 class="text-h2 font-extrabold stretch-heading">{t("projects.title")}</h2>
      <p class="max-w-[60ch] text-lead text-ink">{t("projects.intro")}</p>
    </header>

    {featured && (
      <article class:list={[sheetClass, "md:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)]"]}>
        <div class="flex flex-col gap-4 p-6 md:p-8">
          <span class="text-caption text-redline">{featured.sheet}</span>
          <h3 class="text-h3 font-extrabold stretch-subheading group-hover:text-cobalt">
            <a href={featured.href} class={titleLinkClass}>
              {featured.title}
            </a>
          </h3>
          <p class="text-ink">{featured.shortDesc}</p>
          <ul class="mt-auto flex flex-wrap gap-2 text-caption">
            {featured.tags.map((tag) => (
              <li class="border border-cobalt px-2 py-0.5 text-cobalt">{tag}</li>
            ))}
          </ul>
        </div>
        <Image
          src={featured.cover}
          widths={[400, 700, 1000, 1400]}
          sizes="(min-width: 1100px) 580px, (min-width: 768px) 55vw, 100vw"
          format="webp"
          alt={featured.title}
          style={coverStyle(featured.slug)}
          class="order-first aspect-video h-full w-full border-b-[1.5px] border-ink object-cover md:order-none md:border-b-0 md:border-l-[1.5px]"
        />
      </article>
    )}

    <div class="grid gap-grid sm:grid-cols-2">
      {rest.map((project) => (
        <article class:list={[sheetClass, "grid-rows-[auto_1fr]"]}>
          <Image
            src={project.cover}
            widths={[400, 700, 1000]}
            sizes="(min-width: 1100px) 530px, (min-width: 640px) 50vw, 100vw"
            format="webp"
            alt={project.title}
            style={coverStyle(project.slug)}
            class="aspect-video w-full border-b-[1.5px] border-ink object-cover"
          />
          <div class="flex flex-col gap-3 p-5 md:p-6">
            <span class="text-caption text-redline">{project.sheet}</span>
            <h3 class="text-h3 font-bold stretch-subheading group-hover:text-cobalt">
              <a href={project.href} class={titleLinkClass}>
                {project.title}
              </a>
            </h3>
            <p class="text-small text-ink">{project.shortDesc}</p>
            <ul class="mt-auto flex flex-wrap gap-2 text-caption">
              {project.tags.slice(0, 3).map((tag) => (
                <li class="border border-cobalt px-2 py-0.5 text-cobalt">{tag}</li>
              ))}
              {project.tags.length > 3 && (
                <li class="px-1 py-0.5 text-ink">+{project.tags.length - 3}</li>
              )}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

---
import { Image } from "astro:assets";
import photo from "../assets/img/ivan-foto.jpg";
import { getLang, pathFor, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// Title block (cajetín) of the drawing: the quick facts about Iván.
const titleBlock = [
  { label: t("hero.blockAuthor"), value: "Iván Castro Roel" },
  { label: t("hero.blockLocation"), value: t("about.factLocation") },
  { label: t("hero.blockStudies"), value: t("about.factStudies") },
  { label: t("hero.blockWork"), value: t("about.factWork") },
];
---

<section id="home" class="border-b-[1.5px] border-ink bg-drafting-grid pt-16 font-display text-ink">
  <div class="mx-auto grid max-w-[1100px] gap-grid px-6 pt-section pb-block">
    <div class="grid items-end gap-block md:grid-cols-[minmax(0,1fr)_220px] lg:grid-cols-[minmax(0,1fr)_280px]">
      <div class="min-w-0">
        <h1 class="text-title font-extrabold uppercase stretch-display">
          <span class="block">Iván</span>
          <span class="block">Castro Roel</span>
        </h1>

        <!-- Dimension line with the role: the only load animation of the page. -->
        <p class="relative my-8 flex items-center justify-center text-small font-semibold text-cobalt">
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-1/2 h-[1.5px] origin-left animate-draw bg-cobalt"
          ></span>
          <span
            aria-hidden="true"
            class="absolute top-1/2 left-0 h-3 w-[1.5px] -translate-y-1/2 bg-cobalt"
          ></span>
          <span
            aria-hidden="true"
            class="absolute top-1/2 right-0 h-3 w-[1.5px] -translate-y-1/2 bg-cobalt"
          ></span>
          <span class="relative bg-paper px-3">{t("hero.role")}</span>
        </p>

        <!-- Short bio right under the role (D14). -->
        <div
          id="about"
          class="grid max-w-[60ch] scroll-mt-24 gap-3 text-ink [&_strong]:font-semibold [&_strong]:text-ink"
        >
          <p set:html={t("about.bio1")} />
          <p set:html={t("about.bio2")} />
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={pathFor(lang, "#projects")}
            class="inline-flex h-12 items-center rounded-control bg-ink px-5 font-semibold text-paper hover:bg-cobalt"
          >
            {t("hero.viewProjects")}
          </a>
          <!-- The CV lives in the header on every page, so the hero points to Contact instead. -->
          <a
            href={pathFor(lang, "#contact")}
            class="inline-flex h-12 items-center rounded-control border-frame bg-paper px-5 font-semibold hover:bg-ink hover:text-paper"
          >
            {t("hero.contact")}
          </a>
        </div>
      </div>

      <div class="mx-auto w-full max-w-[280px] md:mx-0">
        <Image
          src={photo}
          widths={[280, 420, 560]}
          width={560}
          height={700}
          fit="cover"
          sizes="280px"
          format="webp"
          loading="eager"
          fetchpriority="high"
          alt={t("hero.photoAlt")}
          class="aspect-[4/5] w-full border-[1.5px] border-ink object-cover"
        />
      </div>
    </div>

    <dl class="grid border-frame bg-paper-raised text-small sm:grid-cols-2 lg:grid-cols-4">
      {titleBlock.map(({ label, value }, index) => (
        <div
          class:list={[
            "min-w-0 border-ink p-3",
            index < 3 && "border-b lg:border-b-0",
            index === 2 && "sm:border-b-0",
            index % 2 === 0 && "sm:border-r",
            index === 1 && "lg:border-r",
          ]}
        >
          <dt class="text-caption text-ink">{label}</dt>
          <dd class="font-semibold">{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

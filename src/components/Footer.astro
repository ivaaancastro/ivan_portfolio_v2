---
import { getLang, useTranslations } from "../i18n/utils";

const t = useTranslations(getLang(Astro.currentLocale));
const currentYear = new Date().getFullYear();

const links = [
  { name: "GitHub", href: "https://github.com/ivaaancastro", external: true },
  { name: "LinkedIn", href: "https://www.linkedin.com/in/ivancastroroel", external: true },
  { name: "Email", href: "mailto:icastror02@gmail.com", external: false },
];

const cell = "min-w-0 border-ink p-3";
const label = "block text-caption text-ink-soft";
---

<!-- Footer drawn as the title block (cajetín) that closes an engineering drawing. -->
<footer class="bg-paper px-6 py-12 font-display text-ink">
  <div class="mx-auto grid max-w-[1100px] border-frame bg-paper-raised text-small sm:grid-cols-2 lg:grid-cols-4">
    <div class:list={[cell, "border-b sm:border-r lg:border-b-0"]}>
      <span class={label}>{t("footer.author")}</span>
      <span class="font-semibold">Iván Castro Roel</span>
    </div>
    <div class:list={[cell, "border-b lg:border-r lg:border-b-0"]}>
      <span class={label}>{t("footer.links")}</span>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {links.map(({ name, href, external }) => (
          <li>
            <a
              href={href}
              class="font-semibold underline decoration-cobalt decoration-[1.5px] underline-offset-4 hover:text-cobalt"
              {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {name}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class:list={[cell, "border-b sm:border-r sm:border-b-0"]}>
      <span class={label}>{t("footer.revision")}</span>
      <span class="font-semibold tabular-nums">{currentYear}</span>
    </div>
    <div class={cell}>
      <span class={label}>&copy; {currentYear} Iván Castro Roel</span>
      <span>{t("footer.rights")}</span>
    </div>
  </div>
</footer>

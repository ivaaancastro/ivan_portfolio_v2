---
import { icons } from "../utils/icons";
import { getStack, localize } from "../utils/content";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const stack = (await getStack()).map(({ data }, index) => ({
  ref: index + 1,
  name: localize(data.name, lang),
  desc: localize(data.desc, lang),
  Icon: icons[data.icon],
}));
---

<section
  id="about"
  class="scroll-mt-16 border-b-[1.5px] border-ink bg-paper py-20 font-display text-ink"
>
  <div class="mx-auto grid max-w-[1100px] gap-12 px-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
    <div class="grid content-start gap-6">
      <h2 class="text-h2 font-extrabold [font-stretch:75%]">{t("about.title")}</h2>
      <div class="grid max-w-[60ch] gap-4 text-lead text-ink-soft [&_strong]:font-semibold [&_strong]:text-ink">
        <p set:html={t("about.bio1")} />
        <p set:html={t("about.bio2")} />
      </div>
    </div>

    <!-- Stack drawn as the bill of materials of the drawing. -->
    <div class="grid content-start gap-3">
      <h3 class="text-h3 font-bold [font-stretch:85%]">{t("about.stackTitle")}</h3>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse border-frame bg-paper-raised text-left text-small">
          <thead class="bg-paper">
            <tr>
              <th scope="col" class="w-12 border border-ink px-3 py-2 font-semibold">
                {t("about.stackRef")}
              </th>
              <th scope="col" class="border border-ink px-3 py-2 font-semibold">
                {t("about.stackTool")}
              </th>
              <th scope="col" class="border border-ink px-3 py-2 font-semibold">
                {t("about.stackUse")}
              </th>
            </tr>
          </thead>
          <tbody>
            {stack.map(({ ref, name, desc, Icon }) => (
              <tr>
                <td class="border border-ink px-3 py-3 text-redline tabular-nums">{ref}</td>
                <th scope="row" class="border border-ink px-3 py-3 font-semibold">
                  <span class="flex items-center gap-2">
                    <Icon className="size-4 shrink-0 text-cobalt" aria-hidden="true" />
                    {name}
                  </span>
                </th>
                <td class="border border-ink px-3 py-3 text-ink-soft">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-small text-ink-soft">{t("about.stackNote")}</p>
    </div>
  </div>
</section>

---
import { MapPin, GraduationCap, Briefcase } from "lucide-react";
import { icons } from "../utils/icons";
import { getStack, localize } from "../utils/content";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const coreStack = (await getStack()).map(({ data }) => ({
  name: localize(data.name, lang),
  desc: localize(data.desc, lang),
  Icon: icons[data.icon],
}));

const facts = [
  { Icon: MapPin, text: t("about.factLocation") },
  { Icon: GraduationCap, text: t("about.factStudies") },
  { Icon: Briefcase, text: t("about.factWork") },
];
---

<section id="about" class="relative overflow-hidden py-24">
  <div class="mx-auto max-w-[1100px] px-6">
    <div data-reveal class="grid items-start gap-12 md:grid-cols-2">
      <!-- Columna Texto -->
      <div>
        <h2 class="mb-6 text-3xl font-bold text-white md:text-4xl">
          {t("about.titleA")} <span class="text-primary">{t("about.titleB")}</span>
        </h2>
        <div class="space-y-4 text-lg leading-relaxed text-gray-400">
          <p set:html={t("about.bio1")} />
          <p set:html={t("about.bio2")} />
        </div>

        <!-- Tira de datos personales -->
        <div
          data-reveal
          style="--reveal-delay: 300ms"
          class="mt-10 flex flex-wrap gap-x-10 gap-y-5 border-t border-white/5 pt-8"
        >
          {facts.map(({ Icon, text }) => (
            <div class="flex items-center gap-3 text-sm text-gray-400">
              <span class="rounded-lg bg-white/5 p-2 text-primary">
                <Icon className="h-4 w-4" aria-hidden="true" />
              </span>
              {text}
            </div>
          ))}
        </div>
      </div>

      <!-- Columna Core Stack -->
      <div>
        <h3 data-reveal class="mb-6 flex items-center gap-2 text-xl font-bold text-white">
          <span class="text-primary" aria-hidden="true">
            ⚡
          </span>{" "}
          {t("about.stackTitle")}
        </h3>

        <div class="grid grid-cols-2 gap-4">
          {coreStack.map(({ name, desc, Icon }, index) => {
            const isLast = index === coreStack.length - 1;
            return (
              <div
                data-reveal
                style={`--reveal-delay: ${index * 100}ms`}
                class:list={[
                  "group rounded-2xl border border-white/10 bg-bg-soft/50 p-5 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-[0_0_20px_rgba(108,240,194,0.1)]",
                  { "col-span-2 flex items-center gap-5": isLast },
                ]}
              >
                <div
                  class:list={[
                    "w-fit rounded-xl bg-white/5 p-3 text-primary transition-colors group-hover:bg-primary group-hover:text-black",
                    isLast ? "shrink-0" : "mb-4",
                  ]}
                >
                  <Icon className="h-6 w-6" aria-hidden="true" />
                </div>
                <div>
                  <h4 class="mb-1 font-bold text-white">{name}</h4>
                  <p class="text-sm leading-relaxed text-gray-400">{desc}</p>
                </div>
              </div>
            );
          })}
        </div>

        <p data-reveal style="--reveal-delay: 500ms" class="mt-6 text-center text-sm text-gray-500">
          {t("about.stackNote")}
        </p>
      </div>
    </div>
  </div>
</section>
